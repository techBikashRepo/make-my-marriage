# Public application origin used to construct absolute URLs.
APP_BASE_URL=http://localhost:3000

# Server-only MongoDB connection string. Never prefix this with NEXT_PUBLIC_.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/make-my-marriage

# Conservative per-runtime Mongoose connection pool limit.
MONGODB_MAX_POOL_SIZE=10

# Authentication settings. Defaults are shown; tune the bcrypt cost after benchmarking.
AUTH_BCRYPT_COST=12
AUTH_SESSION_DAYS=7
AUTH_RESET_MINUTES=30

# Required to send password-reset email. Use a verified Resend sender in deployed environments.
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM=hello@example.com
